+	$settings = array_replace_recursive( vava_booking_questionnaire_defaults(), is_array( $stored ) ? $stored : array() );
+
+	// Client request: permanently retire the Mid-Journey daily-activity question.
+	// Older installations may still have this field inside saved questionnaire
+	// metadata. Filter it from the effective settings so legacy data cannot
+	// reintroduce the question after the default definition is updated.
+	if ( ! empty( $settings['midpoint']['groups'] ) && is_array( $settings['midpoint']['groups'] ) ) {
+		foreach ( $settings['midpoint']['groups'] as &$group ) {
+			if ( empty( $group['fields'] ) || ! is_array( $group['fields'] ) ) {
+				continue;
+			}
+			$group['fields'] = array_values(
+				array_filter(
+					$group['fields'],
+					static function ( $field ): bool {
+						return ! is_array( $field ) || 'daily_activity' !== sanitize_key( (string) ( $field['id'] ?? '' ) );
+					}
+				)
+			);
+		}
+		unset( $group );
+	}
+
+	return $settings;
 }
 
