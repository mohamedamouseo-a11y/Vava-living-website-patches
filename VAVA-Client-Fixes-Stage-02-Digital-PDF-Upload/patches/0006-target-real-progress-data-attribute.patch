diff --git a/wp-content/themes/vava-living-theme-ar-v1/assets/css/admin-selections.css b/wp-content/themes/vava-living-theme-ar-v1/assets/css/admin-selections.css
--- a/wp-content/themes/vava-living-theme-ar-v1/assets/css/admin-selections.css
+++ b/wp-content/themes/vava-living-theme-ar-v1/assets/css/admin-selections.css
@@
+/* Release 1.19.8 — target the actual rendered progress node, independent of wrapper class names. */
+.vava-selections-admin .vava-selections-product-item:has([data-vava-upload-progress].is-active:not([hidden])),
+.vava-selections-admin .vava-repeater-item-body:has([data-vava-upload-progress].is-active:not([hidden])),
+.vava-selections-admin .vava-repeater-field:has([data-vava-upload-progress].is-active:not([hidden])){
+  height:auto!important;
+  min-height:0!important;
+  overflow:visible!important
+}
+.vava-selections-admin .vava-repeater-field:has([data-vava-upload-progress].is-active:not([hidden])){
+  padding-bottom:18px!important
+}
+.vava-selections-admin .vava-media-field:has(> [data-vava-upload-progress].is-active:not([hidden])){
+  display:flex!important;
+  flex-direction:column!important;
+  height:auto!important;
+  min-height:0!important;
+  overflow:visible!important
+}
+.vava-selections-admin [data-vava-upload-progress].is-active:not([hidden]){
