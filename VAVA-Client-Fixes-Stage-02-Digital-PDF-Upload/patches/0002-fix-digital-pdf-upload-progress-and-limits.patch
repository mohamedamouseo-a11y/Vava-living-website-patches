 function vava_digital_products_format_bytes( int $bytes ): string {
 	if ( $bytes <= 0 ) { return '—'; }
 	$units = array( 'B', 'KB', 'MB', 'GB' );
 	$power = min( count( $units ) - 1, (int) floor( log( $bytes, 1024 ) ) );
 	return number_format_i18n( $bytes / pow( 1024, $power ), $power ? 1 : 0 ) . ' ' . $units[ $power ];
 }
+
+/** Effective protected-PDF upload ceiling: product cap constrained by PHP/WordPress. */
+function vava_digital_products_upload_limit_bytes(): int {
+	$hard_limit = 50 * MB_IN_BYTES;
+	$wp_limit   = function_exists( 'wp_max_upload_size' ) ? (int) wp_max_upload_size() : $hard_limit;
+	if ( $wp_limit <= 0 ) { $wp_limit = $hard_limit; }
+	return max( 1, min( $hard_limit, $wp_limit ) );
+}
+
+/** Human-readable PHP upload failure instead of the generic upload error. */
+function vava_digital_products_upload_error_message( int $error ): string {
+	$messages = array(
+		UPLOAD_ERR_INI_SIZE   => 'حجم الملف يتجاوز الحد المسموح به في إعدادات الخادم.',
+		UPLOAD_ERR_FORM_SIZE  => 'حجم الملف يتجاوز الحد المسموح به للنموذج.',
+		UPLOAD_ERR_PARTIAL    => 'تم رفع جزء من الملف فقط. يرجى إعادة المحاولة.',
+		UPLOAD_ERR_NO_FILE    => 'لم يتم استلام ملف PDF.',
+		UPLOAD_ERR_NO_TMP_DIR => 'مجلد الملفات المؤقتة غير متاح على الخادم.',
+		UPLOAD_ERR_CANT_WRITE => 'تعذر كتابة الملف على التخزين في الخادم.',
+		UPLOAD_ERR_EXTENSION  => 'أوقف الخادم رفع الملف قبل اكتماله.',
+	);
+	return $messages[ $error ] ?? 'تعذر رفع الملف.';
+}
